{
  "components": {
    "schemas": {
      "Approval": {
        "description": "Hardware-bound approval signature record (WebAuthn).",
        "properties": {
          "approver_id": {
            "title": "Approver Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "hold_ticket_id": {
            "title": "Hold Ticket Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "tx_digest": {
            "title": "Tx Digest",
            "type": "string"
          },
          "webauthn_signature": {
            "title": "Webauthn Signature",
            "type": "string"
          }
        },
        "required": [
          "id",
          "hold_ticket_id",
          "approver_id",
          "tx_digest",
          "webauthn_signature"
        ],
        "title": "Approval",
        "type": "object"
      },
      "AuditEntry": {
        "description": "Cryptographically chained tamper-evident audit record.",
        "properties": {
          "data_label": {
            "$ref": "#/components/schemas/DataLabel"
          },
          "entry_hash": {
            "title": "Entry Hash",
            "type": "string"
          },
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "prev_hash": {
            "title": "Prev Hash",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "number"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "index",
          "timestamp",
          "event_type",
          "request_id",
          "verdict",
          "prev_hash",
          "entry_hash",
          "data_label"
        ],
        "title": "AuditEntry",
        "type": "object"
      },
      "AuthorizationItem": {
        "description": "EIP-7702 authorization tuple.",
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "chain_id": {
            "title": "Chain Id",
            "type": "integer"
          },
          "nonce": {
            "title": "Nonce",
            "type": "integer"
          }
        },
        "required": [
          "chain_id",
          "address",
          "nonce"
        ],
        "title": "AuthorizationItem",
        "type": "object"
      },
      "BreakerState": {
        "description": "Active circuit breaker status.",
        "properties": {
          "data_label": {
            "$ref": "#/components/schemas/DataLabel",
            "default": "REAL"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "$ref": "#/components/schemas/BreakerStateEnum"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "BreakerState",
        "type": "object"
      },
      "BreakerStateEnum": {
        "description": "Circuit breaker states.",
        "enum": [
          "NORMAL",
          "ELEVATED",
          "HOLD",
          "LOCKDOWN"
        ],
        "title": "BreakerStateEnum",
        "type": "string"
      },
      "CallItem": {
        "description": "Sub-call in a batch or multicall transaction.",
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data"
          },
          "to": {
            "title": "To",
            "type": "string"
          },
          "value": {
            "default": "0",
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "to"
        ],
        "title": "CallItem",
        "type": "object"
      },
      "DataLabel": {
        "description": "Explicit data provenance classifications (Invariant #8).",
        "enum": [
          "REAL",
          "SYNTHETIC",
          "REPORTED"
        ],
        "title": "DataLabel",
        "type": "string"
      },
      "Decision": {
        "description": "Deterministic evaluation outcome issued by BitGuard Decision Point.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "data_label": {
            "$ref": "#/components/schemas/DataLabel"
          },
          "evaluation_latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation Latency Ms"
          },
          "mode": {
            "$ref": "#/components/schemas/OperationMode"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/DecisionReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "risk_score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Risk Score",
            "type": "integer"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
        },
        "required": [
          "request_id",
          "verdict",
          "risk_score",
          "mode",
          "policy_version",
          "data_label"
        ],
        "title": "Decision",
        "type": "object"
      },
      "DecisionReason": {
        "description": "Detailed justification code and metadata for policy decisions.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "weight": {
            "maximum": 100,
            "minimum": 0,
            "title": "Weight",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "weight",
          "detail"
        ],
        "title": "DecisionReason",
        "type": "object"
      },
      "DecodedTx": {
        "description": "Canonical decoded transaction structure extracted strictly from raw bytes.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "asset": {
            "title": "Asset",
            "type": "string"
          },
          "authorizations": {
            "items": {
              "$ref": "#/components/schemas/AuthorizationItem"
            },
            "title": "Authorizations",
            "type": "array"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/CallItem"
            },
            "title": "Calls",
            "type": "array"
          },
          "chain": {
            "title": "Chain",
            "type": "string"
          },
          "digest": {
            "description": "Keccak256 hash or EIP-712 signing digest",
            "title": "Digest",
            "type": "string"
          },
          "fee": {
            "$ref": "#/components/schemas/FeeDetail"
          },
          "from": {
            "title": "From",
            "type": "string"
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To"
          }
        },
        "required": [
          "chain",
          "from",
          "asset",
          "amount",
          "digest"
        ],
        "title": "DecodedTx",
        "type": "object"
      },
      "FeeDetail": {
        "description": "Transaction fee parameters.",
        "properties": {
          "gas_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Gas Limit"
          },
          "max_fee_per_gas": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Fee Per Gas"
          },
          "max_priority_fee_per_gas": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Priority Fee Per Gas"
          }
        },
        "title": "FeeDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HoldTicket": {
        "description": "Durable quarantine record for transactions placed in HOLD.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/DecisionReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "default": "PENDING",
            "title": "Status",
            "type": "string"
          },
          "tx_digest": {
            "title": "Tx Digest",
            "type": "string"
          }
        },
        "required": [
          "id",
          "request_id",
          "tx_digest",
          "expires_at"
        ],
        "title": "HoldTicket",
        "type": "object"
      },
      "OperationMode": {
        "description": "BitGuard operational mode.",
        "enum": [
          "SIMULATION",
          "SHADOW",
          "ENFORCE"
        ],
        "title": "OperationMode",
        "type": "string"
      },
      "PolicyVersion": {
        "description": "Cryptographically signed, versioned policy manifest.",
        "properties": {
          "author": {
            "title": "Author",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "default": false,
            "title": "Is Active",
            "type": "boolean"
          },
          "rules": {
            "additionalProperties": true,
            "title": "Rules",
            "type": "object"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Signature"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "author",
          "rules"
        ],
        "title": "PolicyVersion",
        "type": "object"
      },
      "SigningRequest": {
        "description": "Incoming transaction signing request dispatched to BitGuard.",
        "properties": {
          "chain": {
            "title": "Chain",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "intent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlated withdrawal intent ID",
            "title": "Intent Id"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "mode": {
            "$ref": "#/components/schemas/OperationMode",
            "default": "SIMULATION"
          },
          "raw_tx": {
            "description": "Raw unsigned transaction hex bytes (source of truth)",
            "title": "Raw Tx",
            "type": "string"
          },
          "wallet": {
            "title": "Wallet",
            "type": "string"
          }
        },
        "required": [
          "id",
          "raw_tx",
          "chain",
          "wallet"
        ],
        "title": "SigningRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Verdict": {
        "description": "Firewall decision verdicts.",
        "enum": [
          "ALLOW",
          "HOLD",
          "DENY"
        ],
        "title": "Verdict",
        "type": "string"
      },
      "WatchedAddress": {
        "description": "Internal hot wallet address registered for code hash and delegation watching.",
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "allowed_delegates": {
            "items": {
              "type": "string"
            },
            "title": "Allowed Delegates",
            "type": "array"
          },
          "chain": {
            "title": "Chain",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expected_code_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Code Hash"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "address",
          "chain",
          "label"
        ],
        "title": "WatchedAddress",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Policy Decision Point for exchange hot wallets and custodial signing requests",
    "title": "BitGuard Defensive Signing Firewall",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Kubernetes / Docker health check probe.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/breaker": {
      "get": {
        "description": "Returns current circuit breaker operational state and data provenance label.",
        "operationId": "get_breaker_state_v1_breaker_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BreakerState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get circuit breaker operational state",
        "tags": [
          "V1 Policy Decision Point"
        ]
      }
    },
    "/v1/decisions": {
      "get": {
        "description": "Returns recorded policy decisions ordered by timestamp descending.",
        "operationId": "list_decisions_v1_decisions_get",
        "parameters": [
          {
            "description": "Max decisions to retrieve",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Max decisions to retrieve",
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Offset for pagination",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Offset for pagination",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Decision"
                  },
                  "title": "Response List Decisions V1 Decisions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query policy decision history",
        "tags": [
          "V1 Policy Decision Point"
        ]
      }
    },
    "/v1/evaluate": {
      "post": {
        "description": "Simulates policy evaluation over raw transaction bytes without persisting state or issuing signing tokens. Fails closed by default if the engine is not implemented.",
        "operationId": "evaluate_transaction_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate transaction signing request (dry run)",
        "tags": [
          "V1 Policy Decision Point"
        ]
      }
    },
    "/v1/sign-requests": {
      "post": {
        "description": "Primary signing request entrypoint. Evaluates raw transaction bytes against active policy and generates a single-use approval token if permitted. Fails closed by default if the engine is not implemented.",
        "operationId": "submit_sign_request_v1_sign_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit transaction signing request",
        "tags": [
          "V1 Policy Decision Point"
        ]
      }
    }
  }
}
