# ==============================================================================
# BitGuard Environment Configuration Template
# All secrets must be provided via environment variables. NO REAL SECRETS IN REPO.
# Public testnets and local Anvil chains with disposable keys ONLY.
# ==============================================================================

# --- BitGuard Policy Firewall Service ---
BITGUARD_ENVIRONMENT=development
BITGUARD_HOST=0.0.0.0
BITGUARD_PORT=8000
BITGUARD_LOG_LEVEL=INFO
BITGUARD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitguard
BITGUARD_REDIS_URL=redis://localhost:6379/0
BITGUARD_ANVIL_URL=http://localhost:8545
BITGUARD_SIGNER_SHIM_URL=http://signer_shim:8001
BITGUARD_LEDGER_MOCK_URL=http://localhost:8002

# Policy Limits & Default Thresholds
BITGUARD_APPROVAL_TOKEN_TTL_SECONDS=60
BITGUARD_SINGLE_TX_USD_DEFAULT=50000.0
BITGUARD_WALLET_LIMIT_USD_DEFAULT=100000.0
BITGUARD_GLOBAL_LIMIT_USD_DEFAULT=500000.0
BITGUARD_NEW_RECIPIENT_USD_DEFAULT=10000.0

# --- Signer Shim Service (Enforcement Point) ---
# NOTE: Signer shim runs exclusively on isolated 'signer_internal' Docker network.
SIGNER_SHIM_ENVIRONMENT=development
SIGNER_SHIM_HOST=0.0.0.0
SIGNER_SHIM_PORT=8001
SIGNER_SHIM_LOG_LEVEL=INFO
SIGNER_SHIM_ANVIL_URL=http://anvil:8545
# Anvil Account #0 Disposable Testnet Key (DO NOT USE ON MAINNET / NO REAL FUNDS)
SIGNER_SHIM_TESTNET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Ledger Mock Service (Intent Reconciliation) ---
LEDGER_MOCK_ENVIRONMENT=development
LEDGER_MOCK_HOST=0.0.0.0
LEDGER_MOCK_PORT=8002
LEDGER_MOCK_LOG_LEVEL=INFO

# --- Local Infrastructure (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bitguard
POSTGRES_PORT=5432
REDIS_PORT=6379
ANVIL_PORT=8545
